# higherstudyinfo.com — Apache settings (copied into the site root by the build).
# Every block is guarded with <IfModule>, so a missing module cannot break the site.

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Always use https://higherstudyinfo.com (no www), matching the canonical links.
  # (X-Forwarded-Proto check avoids a redirect loop behind a proxy/CDN that terminates HTTPS.)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://higherstudyinfo.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://higherstudyinfo.com%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType text/calendar .ics
  AddType application/json .json
  AddCharset utf-8 .html .json .txt .ics .js .css .xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/calendar application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType text/calendar "access plus 6 hours"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
